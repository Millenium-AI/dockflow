# Copy this file to `.env` and paste in the two values from
# Supabase -> Project Settings -> API. Both are safe to expose in a browser;
# the anon key is designed to be public and is protected by the table's policies.
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
